# Copy to .env and fill in. Placeholder values only — never commit real secrets.

# Database (portable PostgreSQL — local, Docker, RDS, Cloud SQL, ...)
DATABASE_URL=postgres://airs_app:CHANGE_ME@localhost:5432/airs
DB_DRIVER=postgres

# Authentication adapter: local | oidc   (NOT YET IMPLEMENTED)
AUTH_DRIVER=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME

# Realtime adapter: postgres_listen_notify | websocket   (NOT YET IMPLEMENTED)
REALTIME_DRIVER=postgres_listen_notify

# --- Incident expiration maintenance (Stage 5B) ---------------------------
# Dedicated least-privilege connection for the maintenance runner. This role
# may execute the expiration routine and nothing else; it has no privilege on
# any tenant table. Keep it distinct from DATABASE_URL.
AIRS_MAINTENANCE_DATABASE_URL=postgres://airs_maintenance:CHANGE_ME@localhost:5432/airs

# Optional HTTP trigger. Off unless explicitly set to true; the command-line
# runner is the primary path and needs neither of the next two values.
AIRS_MAINTENANCE_ENDPOINT_ENABLED=false
# Operator secret for POST /api/maintenance/expire-incidents (min 24 chars).
# Generate with: openssl rand -hex 32. Unset or too short => endpoint 503s.
AIRS_MAINTENANCE_SECRET=
# Minimum spacing between accepted HTTP invocations, in milliseconds.
AIRS_MAINTENANCE_MIN_INTERVAL_MS=30000

# How often the bundled compose scheduler runs the sweep, in seconds.
AIRS_MAINTENANCE_INTERVAL_SECONDS=60

# Nitro deployment preset for `npm run build` (node-server | bun | cloudflare-module | ...)
NITRO_PRESET=node-server

# Mapping (MapLibre GL — self-hostable style/tiles, no proprietary key required)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Docker compose credentials (used by docker-compose.yml via .env)
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
MAINTENANCE_DB_PASSWORD=CHANGE_ME

# Optional attribution line displayed under the map (tile licence text).
VITE_MAP_ATTRIBUTION=

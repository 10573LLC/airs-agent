# Database (portable PostgreSQL — local, Docker, RDS, Cloud SQL, ...)
DATABASE_URL=postgres://airs:airs@localhost:5432/airs
DB_DRIVER=postgres

# Authentication adapter: local | oidc
AUTH_DRIVER=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Realtime adapter: postgres_listen_notify | websocket
REALTIME_DRIVER=postgres_listen_notify

# Mapping (MapLibre GL — self-hostable style/tiles, no proprietary key required)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
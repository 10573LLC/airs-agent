# AIRS Agent — line-ending normalization.
#
# Container-init and shell scripts MUST be stored and checked out with LF.
# A CRLF copy of db/init/*.sh makes the PostgreSQL entrypoint fail with
# "/bin/sh^M: bad interpreter" on Windows clones.

*               text=auto eol=lf

*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.js            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
docker-compose.yml text eol=lf

# Windows-only helper: CRLF is correct for PowerShell here.
*.ps1           text eol=crlf

# Binary assets must never be normalized.
*.png           binary
*.ico           binary
*.jpg           binary
*.webp          binary
*.woff          binary
*.woff2         binary

{
  "family": "airs-agent-prod-ops",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::854465560193:role/airs-agent-prod-ops-execution-role",
  "containerDefinitions": [
    {
      "name": "airs-agent-ops",
      "image": "854465560193.dkr.ecr.us-east-1.amazonaws.com/airs-agent@sha256:31c15b9429dfed47b780d9fe9fd41374b26033cab3d6e867657a0c3e215106d5",
      "essential": true,
      "command": [
        "node",
        "-e",
        "const {spawnSync}=require('node:child_process'); const p=spawnSync('psql',[process.env.DATABASE_URL,'-X','-v','ON_ERROR_STOP=1','-c','SELECT current_database(), current_user, ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid();'],{stdio:'inherit'}); if(p.error||p.status!==0)process.exit(p.status||1);const s=spawnSync('node',['scripts/db-migrate.mjs','--status'],{stdio:'inherit'});process.exit(s.status??1);"
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql://postgres@airs-agent-prod-db.c81w4m2mglk7.us-east-1.rds.amazonaws.com:5432/airs_agent?sslmode=verify-full&sslrootcert=/app/certs/rds-us-east-1.pem"
        },
        {
          "value": "15",
          "name": "PGCONNECT_TIMEOUT"
        },
        {
          "value": "-c default_transaction_read_only=on -c statement_timeout=30000",
          "name": "PGOPTIONS"
        }
      ],
      "secrets": [
        {
          "name": "PGPASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:854465560193:secret:rds!db-78a6cd80-b871-4262-b25b-bd847cc34cc3-czSCeB:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/airs-agent-prod-ops",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "preflight"
        }
      },
      "readonlyRootFilesystem": false,
      "user": "node"
    }
  ]
}

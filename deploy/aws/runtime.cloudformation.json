                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "AppPassword"
                    },
                    {
                      "Ref": "SessionSecret"
                    },
                    "arn:aws:secretsmanager:us-east-2:578856792953:secret:airs-agent-prod/oidc-client-nkrLpu"
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "BootstrapExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "airs-agent-prod-bootstrap-execution-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AIRS Ohio runtime; start desired count at zero until database bootstrap passes.",
  "Parameters": {
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1,
        2
      ]
    },
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "ENABLED",
        "DISABLED"
      ]

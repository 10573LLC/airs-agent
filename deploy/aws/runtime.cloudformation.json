                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    "arn:aws:secretsmanager:us-east-2:578856792953:secret:rds!db-14d5fa96-95dc-49d4-a3a7-885b1c3dace3-1alt0v",
                    {
                      "Ref": "AppPassword"
                    },
                    {
                      "Ref": "MaintenancePassword"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "MaintenanceExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "airs-agent-prod-maintenance-execution-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "578856792953"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:ecs:us-east-2:578856792953:*"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedExecution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": "arn:aws:ecr:us-east-2:578856792953:repository/airs-agent"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"

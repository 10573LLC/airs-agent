    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "airs-agent-prod-scheduler-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "578856792953"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:events:us-east-2:578856792953:rule/airs-agent-prod-expiration"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "RunMaintenanceOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecs:RunTask",
                  "Resource": {
                    "Ref": "MaintenanceTask"
                  },
                  "Condition": {
                    "ArnEquals": {
                      "ecs:cluster": "arn:aws:ecs:us-east-2:578856792953:cluster/airs-agent-prod"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::GetAtt": [
                      "MaintenanceExecutionRole",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "ecs-tasks.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "ExpirationSchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "airs-agent-prod-expiration",
        "ScheduleExpression": "rate(5 minutes)",
        "State": {
          "Ref": "ScheduleState"
        },
        "Targets": [
          {
            "Id": "maintenance",
            "Arn": "arn:aws:ecs:us-east-2:578856792953:cluster/airs-agent-prod",
            "RoleArn": {
              "Fn::GetAtt": [

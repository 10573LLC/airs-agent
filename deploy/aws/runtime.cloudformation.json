          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "WebTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "airs-agent-prod",
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "WebExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "airs-agent",
            "Image": "578856792953.dkr.ecr.us-east-2.amazonaws.com/airs-agent@sha256:6d2ff2962d18997ffabbd078e9946805021ca49ae3ac9beaaf05dc3dbdcbed62",
            "Essential": true,
            "User": "node",
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "PORT",
                "Value": "3000"
              },
              {
                "Name": "HOST",
                "Value": "0.0.0.0"
              },
              {
                "Name": "DB_DRIVER",
                "Value": "postgres"
              },
              {
                "Name": "AUTH_DRIVER",
                "Value": "oidc"
              },
              {
                "Name": "AIRS_PUBLIC_BASE_URL",
                "Value": "https://app.airsagent.com"
              },
              {
                "Name": "OIDC_ISSUER",
                "Value": "https://cognito-idp.us-east-2.amazonaws.com/us-east-2_7G9mvWY4g"
              },
              {
                "Name": "OIDC_DOMAIN",
                "Value": "https://airs-agent-578856792953-us-east-2.auth.us-east-2.amazoncognito.com"
              },
              {
                "Name": "OIDC_CLIENT_ID",
                "Value": "4m7j4tbq76eb6afb8mr0jge7ji"
              },
              {
                "Name": "AIRS_APP_RELEASE",
                "Value": "gauntlet-8fb194f-20261002"
              },
              {
                "Name": "DATABASE_URL",
                "Value": "postgresql://airs_app@airs-agent-prod-db.cp8c828kkueu.us-east-2.rds.amazonaws.com:5432/airs_agent?sslmode=verify-full&sslrootcert=/app/certs/rds-us-east-2.pem"
              }
            ],
            "Secrets": [
              {
                "Name": "PGPASSWORD",
                "ValueFrom": {
                  "Ref": "AppPassword"
                }
              },
              {
                "Name": "SESSION_SECRET",
                "ValueFrom": {
                  "Ref": "SessionSecret"
                }
              },
              {
                "Name": "OIDC_CLIENT_SECRET",
                "ValueFrom": "arn:aws:secretsmanager:us-east-2:578856792953:secret:airs-agent-prod/oidc-client-nkrLpu"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/ecs/airs-agent-prod",
                "awslogs-region": "us-east-2",
                "awslogs-stream-prefix": "airs-agent"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "wget -qO- http://127.0.0.1:3000/api/public/health | grep -q '\"status\":\"ok\"' || exit 1"
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 30
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "BootstrapTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "airs-agent-prod-bootstrap",
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "BootstrapExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "bootstrap",
            "Image": "578856792953.dkr.ecr.us-east-2.amazonaws.com/airs-agent@sha256:7db6d0b2d02f4500a77f519159d659d2db8b1a12971920bdf6dbf6e01cd56982",
            "Essential": true,
            "User": "node",
            "Environment": [
              {
                "Name": "DATABASE_URL",
                "Value": "postgresql://postgres@airs-agent-prod-db.cp8c828kkueu.us-east-2.rds.amazonaws.com:5432/airs_agent?sslmode=verify-full&sslrootcert=/app/certs/rds-us-east-2.pem"
              },
              {
                "Name": "PGCONNECT_TIMEOUT",
                "Value": "15"
              }
            ],
            "Secrets": [
              {
                "Name": "PGPASSWORD",
                "ValueFrom": "arn:aws:secretsmanager:us-east-2:578856792953:secret:rds!db-14d5fa96-95dc-49d4-a3a7-885b1c3dace3-1alt0v:password::"
              },
              {
                "Name": "APP_DB_PASSWORD",
                "ValueFrom": {
                  "Ref": "AppPassword"
                }
              },
              {
                "Name": "MAINT_DB_PASSWORD",
                "ValueFrom": {
                  "Ref": "MaintenancePassword"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/ecs/airs-agent-prod-ops",
                "awslogs-region": "us-east-2",
                "awslogs-stream-prefix": "bootstrap"
              }
            },
            "Command": [
              "node",
              "-e",
              "const {spawnSync}=require('node:child_process');const pg=require('pg');(async()=>{let p=spawnSync('node',['scripts/db-migrate.mjs'],{stdio:'inherit'});if(p.status!==0)process.exit(p.status||1);const c=new pg.Client({connectionString:process.env.DATABASE_URL});await c.connect();await c.query('BEGIN');for(const [role,key] of [['airs_app','APP_DB_PASSWORD'],['airs_maintenance','MAINT_DB_PASSWORD']]){const pw=process.env[key];if(!pw||pw.length<32)throw Error('Missing role credential');const r=await c.query('SELECT rolsuper,rolbypassrls,rolcreatedb,rolcreaterole,rolreplication FROM pg_roles WHERE rolname=$1',[role]);if(r.rows.length!==1||Object.values(r.rows[0]).some(Boolean))throw Error('Unsafe database role');await c.query('ALTER ROLE '+pg.escapeIdentifier(role)+' LOGIN PASSWORD '+pg.escapeLiteral(pw));}await c.query('COMMIT');await c.end();p=spawnSync('node',['scripts/db-migrate.mjs','--status'],{stdio:'inherit'});process.exit(p.status||0);})().catch(e=>{console.error('Bootstrap failed:',e.code||e.name);process.exit(1)});"
            ]
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "MaintenanceTask": {
      "Type": "AWS::ECS::TaskDefinition",

            "Essential": true,
            "User": "node",
            "Environment": [
              {
                "Name": "AIRS_MAINTENANCE_DATABASE_URL",
                "Value": "postgresql://airs_maintenance@airs-agent-prod-db.cp8c828kkueu.us-east-2.rds.amazonaws.com:5432/airs_agent?sslmode=verify-full&sslrootcert=/app/certs/rds-us-east-2.pem"
              },
              {
                "Name": "PGCONNECT_TIMEOUT",
                "Value": "15"
              }
            ],
            "Secrets": [
              {
                "Name": "PGPASSWORD",
                "ValueFrom": {
                  "Ref": "MaintenancePassword"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/ecs/airs-agent-prod-maintenance",
                "awslogs-region": "us-east-2",
                "awslogs-stream-prefix": "maintenance"
              }
            },
            "Command": [
              "node",
              "scripts/expire-incident-state.mjs"
            ]
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "AIRS"
          },
          {
            "Key": "Environment",
            "Value": "Production"
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "airs-agent-prod-alb",
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          "subnet-0b00907e3d3d4198e",
          "subnet-09de32da23d65ca56"
        ],
        "SecurityGroups": [
          "sg-08afd21e5cbc9d779"
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": "true"
